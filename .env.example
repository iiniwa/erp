# Copy this file to .env — or just run `make setup`, which does this
# and replaces the CHANGEME placeholders below with randomly generated values.
#
# Compose auto-loads a .env file that sits next to the compose file, so
# `docker compose -f docker-compose.yml ...` (dev) and
# `docker compose -f docker-compose.prod.yml ...` (prod) both pick this
# up without needing --env-file.
#
# Do not use the CHANGEME values as-is, especially if this host is reachable
# from outside localhost (dev services also bind to 127.0.0.1 by default via
# BIND_ADDRESS, but that alone should not be relied on as the only safeguard).

# Bind published dev ports to loopback only. Set to 0.0.0.0 to expose on the
# LAN (e.g. testing from another device), but only on a trusted network.
BIND_ADDRESS=127.0.0.1

# --- MariaDB ---
DB_NAME=app_development
DB_PASSWORD=CHANGEME
DB_PORT=3306
DB_ROOT_PASSWORD=CHANGEME
DB_USERNAME=app

# --- Rails backend ---
BACKEND_PORT=3001
# Generate locally with: docker compose -f docker-compose.yml run --rm backend bin/rails secret
RAILS_MASTER_KEY=

# --- Next.js frontend ---
FRONTEND_PORT=3000

# --- Internal BFF -> Rails API authentication (shared secret) ---
INTERNAL_API_SECRET=CHANGEME

# --- SFTPGo ---
SFTPGO_ADMIN_USER=admin
SFTPGO_ADMIN_PASSWORD=CHANGEME
SFTPGO_WEBADMIN_PORT=8080
SFTPGO_SFTP_PORT=2022

# --- Required only by docker-compose.prod.yml ---
# FRONTEND_ORIGIN=https://erp.example.com
# REDIS_URL=redis://your-redis-host:6379/1
