# Copy this file to .env at the repo root and adjust as needed.
# `docker compose --env-file .env -f docker/docker-compose.yml ...` (dev) or
# `docker compose --env-file .env -f docker/docker-compose.prod.yml ...` (prod)
# picks this up automatically. `make build dev|prod` uses the same file.

# --- MariaDB ---
DB_ROOT_PASSWORD=root
DB_NAME=app_development
DB_USERNAME=app
DB_PASSWORD=app
DB_PORT=3306

# --- Rails backend ---
BACKEND_PORT=3001
# Generate locally with: bin/rails secret (or fetch from your team's secret store)
RAILS_MASTER_KEY=

# --- Next.js frontend ---
FRONTEND_PORT=3000
# Required in production (docker-compose.prod.yml); e.g. https://erp.example.com
NEXTAUTH_URL=http://localhost:3000

# --- Internal BFF -> Rails API authentication (shared secret) ---
INTERNAL_API_SECRET=dev-internal-secret

# --- SFTPGo ---
SFTPGO_ADMIN_USER=admin
SFTPGO_ADMIN_PASSWORD=admin12345
SFTPGO_WEBADMIN_PORT=8080
SFTPGO_SFTP_PORT=2022

# --- Required only by docker-compose.prod.yml ---
# FRONTEND_ORIGIN=https://erp.example.com
